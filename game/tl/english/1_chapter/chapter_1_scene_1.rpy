# game/1_chapter/chapter_1_scene_1.rpy:1038
translate english chapter_1_scene_1_after_locks_6c73edd3:

    # "Витя, мой муж, часто бывал просто невыносим."
    "Vitya, my husband, was often simply unbearable."

# game/1_chapter/chapter_1_scene_1.rpy:1063
translate english chapter_1_scene_1_after_locks_b89906bb:

    # vit "Привет."
    vit "Hey."

# game/1_chapter/chapter_1_scene_1.rpy:1069
translate english chapter_1_scene_1_after_locks_2ed7ee87:

    # vit "Что, опять уснула?" (callback=talk_callback("vit", moves=2, hold=0.2, fade=0.2, step=0.5))
    vit "What, fell asleep again?" (callback=talk_callback("vit", moves=2, hold=0.2, fade=0.2, step=0.5))

# game/1_chapter/chapter_1_scene_1.rpy:1071
translate english chapter_1_scene_1_after_locks_b9306f19:

    # vit "Не прошло и полгода!.."
    vit "Took you long enough!.."

# game/1_chapter/chapter_1_scene_1.rpy:1075
translate english chapter_1_scene_1_after_locks_4e094c73:

    # vit "Я уже думал, снова выбивать дверь придётся."
    vit "I was starting to think I'd have to break the door down again."

# game/1_chapter/chapter_1_scene_1.rpy:1089
translate english chapter_1_scene_1_after_locks_ab2d7b11:

    # "Ничего серьёзного: какие-то банальности, быт..."
    "Nothing serious: some banalities, everyday life..."

# game/1_chapter/chapter_1_scene_1.rpy:1112
translate english chapter_1_scene_1_after_locks_9775261f:

    # "И эти его дурацкие, неискоренимые привычки."
    "And those stupid, ineradicable habits of his."

# game/1_chapter/chapter_1_scene_1.rpy:1113
translate english chapter_1_scene_1_after_locks_7b2e2290:

    # "\"Мелочи\". Так он их называл."
    "\"Small stuff.\" That is what he called them."

# game/1_chapter/chapter_1_scene_1.rpy:1146
translate english chapter_1_scene_1_tv_5e932996:

    # mar "Вить, по поводу..."
    mar "Vitya, about..."

# game/1_chapter/chapter_1_scene_1.rpy:1152
translate english chapter_1_scene_1_tv_a4650932:

    # vit "Всё потом, Марин!"
    vit "Later, Marina!"

# game/1_chapter/chapter_1_scene_1.rpy:1157
translate english chapter_1_scene_1_tv_cb06eff3:

    # vit "Сейчас — новости."
    vit "The news is on."

# game/1_chapter/chapter_1_scene_1.rpy:1184
translate english chapter_1_scene_1_tv_dialogue_47a84dd2:

    # "И каждый наш день состоял из этих \"мелочей\"."
    "And every one of our days was made up of that \"small stuff\"."

# game/1_chapter/chapter_1_scene_1.rpy:1185
translate english chapter_1_scene_1_tv_dialogue_8b7866af:

    # "Снова пропустили запись? Мелочь. Потом сходим."
    "Missed the appointment again? Small stuff. We'll go later."

# game/1_chapter/chapter_1_scene_1.rpy:1186
translate english chapter_1_scene_1_tv_dialogue_ccdd8530:

    # "Опять разбросаны носки по всей квартире? Мелочь. Пусть лежат."
    "Socks scattered all over the apartment again? Small stuff. Let them lie."

# game/1_chapter/chapter_1_scene_1.rpy:1195
translate english chapter_1_scene_1_tv_dialogue_a435b571:

    # vit "Кошмар какой... слышала?"
    vit "What a nightmare... did you hear that?"

# game/1_chapter/chapter_1_scene_1.rpy:1196
translate english chapter_1_scene_1_tv_dialogue_94e23acd:

    # vit "Как хорошо, что у нас всё в порядке."
    vit "Good thing everything's fine with us."

# game/1_chapter/chapter_1_scene_1.rpy:1216
translate english chapter_1_scene_1_cleanup_4c2f800d:

    # "Утешать себя чужими плохими вестями — это важно."
    "Comforting yourself with other people's bad news — that is important."

# game/1_chapter/chapter_1_scene_1.rpy:1217
translate english chapter_1_scene_1_cleanup_7c8a8a69:

    # "А вот гора немытой посуды — это мелочь. Встань и помой. Ты же тут хозяйка."
    "A mountain of dirty dishes, though — that is small stuff. Get up and wash them. You are the lady of the house, after all."

# game/1_chapter/chapter_1_scene_1.rpy:1218
translate english chapter_1_scene_1_cleanup_5507f920:

    # "Потом будет ещё одна мелочь."
    "Then there will be more small stuff."

# game/1_chapter/chapter_1_scene_1.rpy:1219
translate english chapter_1_scene_1_cleanup_6c318d0f:

    # "И ещё одна. И ещё одна. Снова и снова."
    "And more. And more. Over and over again."

# game/1_chapter/chapter_1_scene_1.rpy:1244
translate english chapter_1_scene_1_cleanup_d3ec374c:

    # "Как же это выводит из себя."
    "How it drives you mad."

# game/1_chapter/chapter_1_scene_1.rpy:1245
translate english chapter_1_scene_1_cleanup_311abc24:

    # "Ты раз за разом просишь, напоминаешь, умоляешь..."
    "Time after time you ask, you remind, you beg..."

# game/1_chapter/chapter_1_scene_1.rpy:1246
translate english chapter_1_scene_1_cleanup_0c9352aa:

    # "Скандалишь, наконец, а тебя абсолютно не слышат."
    "You finally make a scene, and still nobody hears you at all."

# game/1_chapter/chapter_1_scene_1.rpy:1247
translate english chapter_1_scene_1_cleanup_9e8a6927:

    # "Потому что твои причитания — это мелочь."
    "Because your whining is small stuff."

# game/1_chapter/chapter_1_scene_1.rpy:1279
translate english chapter_1_scene_1_cleanup_e1da04ab:

    # vit "Ну же! Давай!"
    vit "Come on! Go, go!"

# game/1_chapter/chapter_1_scene_1.rpy:1289
translate english chapter_1_scene_1_cleanup_40d23a1e:

    # mar "Я хотела обсудить кое-что..."
    mar "I wanted to discuss something..."

# game/1_chapter/chapter_1_scene_1.rpy:1291
translate english chapter_1_scene_1_cleanup_fd38df9f:

    # vit "Да погоди, Марин! Если наши сейчас не забьют, то..."
    vit "Hold on, Marina! If our guys don't score now, then..."

# game/1_chapter/chapter_1_scene_1.rpy:1294
translate english chapter_1_scene_1_cleanup_d4ff92f2:

    # mar "Наши выигрывают?"
    mar "Are our guys winning?"

# game/1_chapter/chapter_1_scene_1.rpy:1296
translate english chapter_1_scene_1_cleanup_6a8ed444:

    # vit "Да какой там! Если сейчас не забьют, то всё!.."
    vit "Fat chance! If they don't score now, it's over!.."

# game/1_chapter/chapter_1_scene_1.rpy:1299
translate english chapter_1_scene_1_cleanup_c97a377d:

    # mar "Долго до конца матча?"
    mar "How long till the match is over?"

# game/1_chapter/chapter_1_scene_1.rpy:1301
translate english chapter_1_scene_1_cleanup_947f8cc2:

    # vit "Сейчас уже всё решится. Пан или пропал. Гол или..."
    vit "It's all about to be decided. Do or die. A goal, or..."

# game/1_chapter/chapter_1_scene_1.rpy:1309
translate english chapter_1_scene_1_cleanup_e01f20f9:

    # tvv "И!.. Это штанга! Всё! Похоже, сегодня уже не отыграться! Конец надеждам!"
    tvv "And!.. It's the post! That's it! Looks like there's no coming back tonight! Hopes dashed!"

# game/1_chapter/chapter_1_scene_1.rpy:1314
translate english chapter_1_scene_1_cleanup_9510c7da:

    # vit "Вершинин, ну какой же ты кривоногий! Нет слов! Марин, ты это видела?"
    vit "Vershinin, you bow-legged clod! Words fail me! Marina, did you see that?"

# game/1_chapter/chapter_1_scene_1.rpy:1315
translate english chapter_1_scene_1_cleanup_9c3b037c:

    # vit "Кто так играет?!"
    vit "Who plays like that?!"

# game/1_chapter/chapter_1_scene_1.rpy:1341
translate english chapter_1_scene_1_cleanup_5a1aceea:

    # vit "Не могу дальше на это смотреть..."
    vit "I can't watch this anymore..."

# game/1_chapter/chapter_1_scene_1.rpy:1368
translate english chapter_1_scene_1_cleanup_b04060a7:

    # mar "Почему так сложно не разбрасывать грязные вонючие носки по всей квартире?"
    mar "Why is it so hard not to leave your dirty, stinking socks all over the apartment?"

# game/1_chapter/chapter_1_scene_1.rpy:1370
translate english chapter_1_scene_1_cleanup_8c9016b8:

    # vit "Опять ты про эти мелочи. Ну, не мешают же эти носки. Дорогу не перегораживают."
    vit "There you go about the small stuff again. The socks aren't bothering anyone. They're not blocking the way."

# game/1_chapter/chapter_1_scene_1.rpy:1371
translate english chapter_1_scene_1_cleanup_a3cd4ea2:

    # vit "Мне после работы иногда ложку до рта донести сил не хватает."
    vit "Some days after work I don't even have the strength to lift a spoon to my mouth."

# game/1_chapter/chapter_1_scene_1.rpy:1372
translate english chapter_1_scene_1_cleanup_ab88e3d1:

    # vit "Вот ты сидишь весь день дома. Я зарабатываю — ты убираешься."
    vit "You sit at home all day. I earn the money, you do the cleaning."

# game/1_chapter/chapter_1_scene_1.rpy:1375
translate english chapter_1_scene_1_cleanup_a141fe1e:

    # mar "Как у тебя на работе дела? Ничего не рассказываешь..."
    mar "How are things at work? You never tell me anything..."

# game/1_chapter/chapter_1_scene_1.rpy:1377
translate english chapter_1_scene_1_cleanup_a0631260:

    # vit "Да завал полный. В отпуск не отпускают, угрожают сокращениями."
    vit "Completely swamped. They won't let me take a vacation, and they keep threatening layoffs."

# game/1_chapter/chapter_1_scene_1.rpy:1378
translate english chapter_1_scene_1_cleanup_77d9be47:

    # vit "Но ты не переживай, у нас всё нормально будет."
    vit "But don't you worry, we'll be fine."

# game/1_chapter/chapter_1_scene_1.rpy:1381
translate english chapter_1_scene_1_cleanup_668aa083:

    # mar "Ты помнишь? Тамара Виталиевна ждёт нас троих завтра..."
    mar "Do you remember? Tamara Vitalievna is expecting the three of us tomorrow..."

# game/1_chapter/chapter_1_scene_1.rpy:1383
translate english chapter_1_scene_1_cleanup_4c863e18:

    # vit "Завтра не получится. Прости."
    vit "Tomorrow won't work. Sorry."

# game/1_chapter/chapter_1_scene_1.rpy:1387
translate english chapter_1_scene_1_cleanup_d1eae8eb:

    # vit "Завтра мне надо с коллегами встретиться."
    vit "I have to meet up with some colleagues tomorrow."

# game/1_chapter/chapter_1_scene_1.rpy:1388
translate english chapter_1_scene_1_cleanup_c4f1c2bd:

    # vit "Так что с Тамарой как-нибудь в следующий раз..."
    vit "So Tamara will have to wait till next time..."

# game/1_chapter/chapter_1_scene_1.rpy:1396
translate english chapter_1_scene_1_cleanup_ca65c8db:

    # mar "Это уже четвёртая отмена! Тамара Виталиевна..."
    mar "That's the fourth time we've canceled! Tamara Vitalievna..."

# game/1_chapter/chapter_1_scene_1.rpy:1398
translate english chapter_1_scene_1_cleanup_d6f7985c:

    # vit "Тамара Виталиевна потерпит! Она очень хорошо получает за каждый приём."
    vit "Tamara Vitalievna can wait! She gets paid very well for every session."

# game/1_chapter/chapter_1_scene_1.rpy:1401
translate english chapter_1_scene_1_cleanup_01b105f3:

    # mar "Понятно..."
    mar "I see..."

# game/1_chapter/chapter_1_scene_1.rpy:1403
translate english chapter_1_scene_1_cleanup_654a8652:

    # vit "Что тебе понятно?! Ну не могу я шляться с тобой по твоим подружкам."
    vit "What do you see?! I can't go traipsing around with you to your girlfriends."

# game/1_chapter/chapter_1_scene_1.rpy:1406
translate english chapter_1_scene_1_cleanup_294fbea3:

    # mar "Тебе ещё самому не надоело?! Каждый раз одно и то же!"
    mar "Aren't you sick of it yourself?! It's the same thing every time!"

# game/1_chapter/chapter_1_scene_1.rpy:1407
translate english chapter_1_scene_1_cleanup_a1bf6fc2:

    # mar "Что ты скажешь теперь? \"Это мелочь, Марин, просто запишемся ещё раз\"?!"
    mar "What will you say now? \"It's small stuff, Marina, we'll just book another appointment\"?!"

# game/1_chapter/chapter_1_scene_1.rpy:1411
translate english chapter_1_scene_1_cleanup_488d4ee8:

    # vit "У меня есть и другие дела, понятно?! Помимо собственной работы и этих твоих \"терапий\"!"
    vit "I have other things to do, got it?! Besides my own job and these \"therapies\" of yours!"

# game/1_chapter/chapter_1_scene_1.rpy:1412
translate english chapter_1_scene_1_cleanup_efda0858:

    # vit "Я не могу весь день валяться дома, а потом ныть какой-то старой мымре о том, как в жизни всё хреново!"
    vit "I can't lie around the house all day and then whine to some old hag about how crappy life is!"

# game/1_chapter/chapter_1_scene_1.rpy:1414
translate english chapter_1_scene_1_cleanup_a98992ee:

    # vit "Кто-то должен оплачивать такие развлечения!"
    vit "Somebody has to pay for that kind of entertainment!"

# game/1_chapter/chapter_1_scene_1.rpy:1415
translate english chapter_1_scene_1_cleanup_f06786a8:

    # vit "Вставать по утрам, а не к обеду. А потом пахать весь день."
    vit "Get up in the morning, not at noon. And then slave away all day."

# game/1_chapter/chapter_1_scene_1.rpy:1416
translate english chapter_1_scene_1_cleanup_0b73c778:

    # vit "Держать себя в руках!"
    vit "Keep it together!"

# game/1_chapter/chapter_1_scene_1.rpy:1420
translate english chapter_1_scene_1_cleanup_f822e506:

    # "{cps=5}...{/cps}"
    "{cps=5}...{/cps}"

# game/1_chapter/chapter_1_scene_1.rpy:1421
translate english chapter_1_scene_1_cleanup_015a7ec4:

    # "Кто-то из мудрых сказал, что залог счастливого супружества — взаимные компромиссы."
    "Some wise person once said that the key to a happy marriage is mutual compromise."

# game/1_chapter/chapter_1_scene_1.rpy:1422
translate english chapter_1_scene_1_cleanup_5983a41e:

    # "Но, боюсь... за все восемь лет брака, я поняла, что одних компромиссов мало."
    "But I am afraid... in all eight years of marriage, I learned that compromise alone is not enough."

